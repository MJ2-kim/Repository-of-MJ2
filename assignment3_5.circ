  <vhdl appearance="logisim_evolution" name="d_ff_async">library IEEE;&#13;
use IEEE.STD_LOGIC_1164.ALL;&#13;
&#13;
entity d_ff_async is&#13;
    Port ( clk  : in  STD_LOGIC;&#13;
           set  : in  STD_LOGIC;&#13;
           clr  : in  STD_LOGIC;&#13;
           D    : in  STD_LOGIC;&#13;
           Q    : out STD_LOGIC;&#13;
           Qbar : out STD_LOGIC);&#13;
end d_ff_async;&#13;
&#13;
architecture Behavioral of d_ff_async is&#13;
    signal q_int : std_logic := '0';&#13;
begin&#13;
    process(clk, set, clr)&#13;
    begin&#13;
        -- 1. Asynchronous Clear&#13;
        if clr = '1' then&#13;
            q_int &lt;= '0';&#13;
        -- 2. Asynchronous Set&#13;
        elsif set = '1' then&#13;
            q_int &lt;= '1';&#13;
        -- 3. Normal D-FF Operation &#13;
        elsif rising_edge(clk) then&#13;
            q_int &lt;= D;&#13;
        end if;&#13;
    end process;&#13;
&#13;
    Q    &lt;= q_int;&#13;
    Qbar &lt;= not q_int;&#13;
end Behavioral;&#13;
</vhdl>
