  <vhdl appearance="logisim_evolution" name="jk_ff">library IEEE;&#13;
use IEEE.STD_LOGIC_1164.ALL;&#13;
&#13;
entity jk_ff is&#13;
    Port ( clk  : in  STD_LOGIC;&#13;
           J    : in  STD_LOGIC;&#13;
           K    : in  STD_LOGIC;&#13;
           Q    : out STD_LOGIC;&#13;
           Qbar : out STD_LOGIC);&#13;
end jk_ff;&#13;
&#13;
architecture Behavioral of jk_ff is&#13;
    signal q_int : std_logic := '0';&#13;
begin&#13;
    process(clk)&#13;
    begin&#13;
        if rising_edge(clk) then&#13;
            if (J = '0' and K = '0') then&#13;
                q_int &lt;= q_int;        -- Hold&#13;
            elsif (J = '0' and K = '1') then&#13;
                q_int &lt;= '0';          -- Reset&#13;
            elsif (J = '1' and K = '0') then&#13;
                q_int &lt;= '1';          -- Set&#13;
            elsif (J = '1' and K = '1') then&#13;
                q_int &lt;= not q_int;    -- Toggle&#13;
            end if;&#13;
        end if;&#13;
    end process;&#13;
&#13;
    Q    &lt;= q_int;&#13;
    Qbar &lt;= not q_int;&#13;
end Behavioral;&#13;
</vhdl>
