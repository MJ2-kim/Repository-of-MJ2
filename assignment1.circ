    <wire from="(260,260)" to="(260,290)"/>
    <wire from="(480,200)" to="(510,200)"/>
    <wire from="(480,220)" to="(510,220)"/>
  </circuit>
  <vhdl appearance="logisim_evolution" name="assignment1">library ieee;
use ieee.std_logic_1164.all;

entity assignment1 is
    port(
        a, b, c, d : in  std_logic;
        out1       : out std_logic;
        out2       : out std_logic
    );
end entity assignment1;

architecture bhv of assignment1 is
begin
    out1 &lt;= a and b and c and d;
    out2 &lt;= a or b or c or d;
end architecture bhv;</vhdl>
