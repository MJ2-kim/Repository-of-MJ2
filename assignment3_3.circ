  <vhdl appearance="logisim_evolution" name="d_ff">library IEEE;&#13;
use IEEE.STD_LOGIC_1164.ALL;&#13;
&#13;
entity d_ff is&#13;
    Port ( clk  : in  STD_LOGIC;&#13;
           D    : in  STD_LOGIC;&#13;
           Q    : out STD_LOGIC;&#13;
           Qbar : out STD_LOGIC);&#13;
end d_ff;&#13;
&#13;
architecture Behavioral of d_ff is&#13;
    signal q_int : std_logic := '0';&#13;
begin&#13;
    process(clk)&#13;
    begin&#13;
        &#13;
        if rising_edge(clk) then&#13;
            q_int &lt;= D;&#13;
        end if;&#13;
    end process;&#13;
&#13;
    Q    &lt;= q_int;&#13;
    Qbar &lt;= not q_int;&#13;
end Behavioral;&#13;
</vhdl>
