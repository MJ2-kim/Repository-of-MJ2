    <comp lib="6" loc="(540,180)" name="7-Segment Display"/>
    <comp loc="(400,170)" name="assignment3"/>
    <wire from="(150,170)" to="(180,170)"/>
    <wire from="(400,170)" to="(440,170)"/>
    <wire from="(460,160)" to="(460,180)"/>
    <wire from="(460,160)" to="(540,160)"/>
