    <wire from="(490,250)" to="(540,250)"/>
    <wire from="(500,230)" to="(500,260)"/>
    <wire from="(500,260)" to="(550,260)"/>
    <wire from="(510,240)" to="(510,270)"/>
    <wire from="(510,270)" to="(560,270)"/>
    <wire from="(540,160)" to="(540,180)"/>
    <wire from="(540,240)" to="(540,250)"/>
    <wire from="(550,150)" to="(550,180)"/>
    <wire from="(550,240)" to="(550,260)"/>
